# Required
BOT_TOKEN=123456:replace-with-a-real-token

# PostgreSQL is recommended for production. SQLite is convenient locally.
DATABASE_URL=sqlite+aiosqlite:///./bot.db
# DATABASE_URL=postgresql+asyncpg://telegram_bot:change-me@postgres:5432/telegram_bot

# Comma-separated Telegram IDs with production dispatcher access.
ADMIN_IDS=
DEV_MODE=false
REDIS_URL=
# REDIS_URL=redis://redis:6379/0

# Escalate new, unclaimed requests after this many minutes.
ESCALATION_MINUTES=20

# Optional OpenAI-compatible LLM integration.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15
LLM_AUTO_CATEGORY_THRESHOLD=0.75
